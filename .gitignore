# Raw downloads are large and re-downloadable; only the manifest is tracked.
data/raw/**
!data/raw/.gitkeep
!data/raw/manifest.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Open-descriptor caches are large and deterministically regenerable by
# experiments/02_features.py, so they are not tracked.
data/features/rdkit2d.csv
data/features/morgan.csv
data/features/mordred.csv

# alvaDesc exports are large (~34 MB) and licence-gated; not tracked. Regenerate
# them by running alvaDesc on data/features/alvadesc_inputs/*.smi (see
# ALVADESC_INSTRUCTIONS.md). Expected checksums are recorded in PROVENANCE.md.
# The .smi inputs themselves stay tracked.
data/features/alvadesc_*.csv
data/features/alvadesc_*.txt

# Run logs are noise, not results.
results/*.log
results/metrics_*.log

# Do NOT ignore processed data, results, tables, figures — those are the
# reproducible outputs and are tracked so a reviewer can diff them.
